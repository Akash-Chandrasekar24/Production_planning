# Copy to .env (git-ignored). Names follow AI_Agent_Development_Setup_Guide.docx. Never commit real values.
DOMO_SUBDOMAIN=gwcteq-partner
DOMO_TOKEN=
DOMO_MODEL=domo.domo_ai.domogpt-large-v3:anthropic   # primary
DOMO_FALLBACK_MODEL=domo.openai.gpt-5.6-sol          # used once if the primary call fails
# DOMO_USE_SESSION_ID=true  # Domo 404s on session IDs it did not create, so leave off
# DOMO_JSON_MODE=true        # sends responseFormat; confirm the exact "type" value in the Domo Playground first

# Read/write application role (Postgres/Neon). Unset = local SQLite file.
DATABASE_URL=postgresql://agent_rw:change_me@localhost:5432/agentdb
# SELECT-only role for the agent's SQL tool (create it with db.sql). Unset = SQL tool disabled.
READONLY_DATABASE_URL=postgresql://agent_ro:change_me_ro@localhost:5432/agentdb

# NEON_API_KEY=            # lets the model query via the Neon MCP server (read-only)
# NEON_PROJECT_ID=  NEON_BRANCH_ID=  NEON_DATABASE_NAME=neondb
# NVIDIA NemoGuard guardrails (build.nvidia.com). Required: without it the assistant stays off (fail closed).
NVIDIA_API_KEY=
# Encrypts saved connector passwords. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_KEY=
# AUTH_MODE=dev_headers  DATA_SOURCE=auto  PLANNING_DATA_DIR=  CORS_ORIGINS=http://localhost:5173
